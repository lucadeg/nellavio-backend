{
  "name": "nellavio-backend",
  "version": "2.0.1",
  "description": "Open source Node.js backend for Nellavio dashboard",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Mateusz Wyrębek",
    "email": "mateusz.wyrebek@gmail.com",
    "url": "https://matt765.dev/"
  },
  "main": "build/src/server.js",
  "scripts": {
    "postinstall": "echo 'Skipping prisma generate during install'",
    "build": "tsc && node --input-type=commonjs -e \"require('fs').cpSync('src/generated','build/src/generated',{recursive:true})\"",
    "start": "node ./build/src/server.js",
    "dev": "nodemon -q --watch ./build/src --delay 500ms ./build/src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "engines": {
    "node": "^22.22.1 || >=24.0.0",
    "npm": ">=7.19"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "graphql": "^16.14.2",
    "graphql-type-json": "^0.3.2",
    "mercurius": "^16.10.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "typescript": "^6.0.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "vitest-mock-extended": "^5.1.1"
  }
}
